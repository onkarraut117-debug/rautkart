# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#     cp .env.example .env
#
# Docker Compose reads .env automatically. For the manual (non-Docker) setup,
# export these in your shell before starting the backend.

# PostgreSQL password.
DB_PASSWORD=change_me

# Signing key for JWTs. Anyone holding this can forge tokens, including admin
# tokens. Generate a fresh one with:  openssl rand -base64 32
JWT_SECRET=

# Razorpay TEST-mode keys from https://dashboard.razorpay.com (Test Mode).
# Leave both blank to run checkout in mock-payment mode - no Razorpay call is
# made and orders complete immediately. Never put live keys here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Host ports, if the defaults clash with something already running.
# FRONTEND_PORT=5173
# BACKEND_PORT=8080
# DB_PORT=5433
